DATABASE_PATH=data/memory.sqlite3
MODEL_PROVIDER=deterministic
# Local development uses bearer tokens. Enable cookie auth only behind HTTPS.
APP_ENV=development
DEMO_INVITATIONS_REQUIRED=false
SESSION_COOKIE_AUTH=false
SESSION_COOKIE_SECURE=false
ENABLE_HSTS=false
# Body and abuse limits. Model action caps are process-local and reset on restart.
MAX_REQUEST_BODY_BYTES=65536
REGISTER_RATE_LIMIT=5
REGISTER_RATE_WINDOW_SECONDS=3600
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW_SECONDS=900
CHAT_RATE_LIMIT=20
CHAT_RATE_WINDOW_SECONDS=60
MODEL_ACTIONS_PER_USER_PER_DAY=25
MODEL_ACTIONS_PER_DAY=200
# For MODEL_PROVIDER=ollama (local server, model must already be installed):
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2:3b
# For GroqCloud (requires an eligible account; keep the real key only in local .env):
# MODEL_PROVIDER=groq
# GROQ_API_KEY=replace-with-your-groq-api-key
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
